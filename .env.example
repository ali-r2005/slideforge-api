# SlideForge API - Environment Configuration Example

# =========================================================================
# AI MODEL CONFIGURATION (OpenRouter)
# =========================================================================
# Your OpenRouter API Key (e.g. sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The LLM model you want to use. Make sure the model supports JSON mode response formats.
# Default: qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct


# =========================================================================
# THIRD-PARTY INTEGRATIONS
# =========================================================================
# Pexels API Key used to search and download high-quality images related to presentation topics.
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Logo.dev Public API Key used to fetch company/brand logos based on website domains.
# Get yours at: https://logo.dev/
LOGO_DEV_PUBLIC_KEY=your_logo_dev_public_key_here

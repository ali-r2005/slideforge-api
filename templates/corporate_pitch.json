{
  "name": "corporate_pitch",
  "description": "Corporate pitch presentation with contact and company information",
  "system_instructions": "Generate a professional corporate pitch presentation that effectively communicates the company's value proposition to the target audience.",
  "tone": "professional and persuasive",

  "schema": {
    "fields": [
      {
        "name": "presenter_first_name",
        "type": "text",
        "required": true,
        "label": "First Name",
        "description": "Presenter's first name",
        "max_length": 50
      },
      {
        "name": "presenter_last_name",
        "type": "text",
        "required": true,
        "label": "Last Name",
        "description": "Presenter's last name",
        "max_length": 50
      },
      {
        "name": "presenter_title",
        "type": "text",
        "required": true,
        "label": "Job Title",
        "description": "Job title or role",
        "max_length": 100
      },
      {
        "name": "presenter_email",
        "type": "email",
        "required": true,
        "label": "Email Address",
        "description": "Contact email"
      },
      {
        "name": "presenter_phone",
        "type": "text",
        "required": false,
        "label": "Phone Number",
        "description": "Contact phone number",
        "max_length": 20
      },
      {
        "name": "company_name",
        "type": "text",
        "required": true,
        "label": "Company Name",
        "description": "Name of your company",
        "max_length": 100
      },
      {
        "name": "company_industry",
        "type": "enum",
        "required": true,
        "label": "Industry",
        "description": "Company industry sector",
        "values": ["Technology", "Finance", "Healthcare", "Retail", "Manufacturing", "Other"]
      },
      {
        "name": "company_size",
        "type": "enum",
        "required": true,
        "label": "Company Size",
        "description": "Number of employees",
        "values": ["1-50", "51-200", "201-1000", "1000+"]
      },
      {
        "name": "company_website",
        "type": "text",
        "required": false,
        "label": "Company Website",
        "description": "Company website URL",
        "max_length": 200
      },
      {
        "name": "company_description",
        "type": "textarea",
        "required": true,
        "label": "Company Description",
        "description": "Brief description of your company and services",
        "max_length": 500
      },
      {
        "name": "pitch_focus",
        "type": "textarea",
        "required": true,
        "label": "Pitch Focus",
        "description": "Main topic or focus of your presentation",
        "max_length": 500
      },
      {
        "name": "target_audience",
        "type": "enum",
        "required": true,
        "label": "Target Audience",
        "description": "Who is this pitch for?",
        "values": ["Investors", "Customers", "Partners", "Employees", "Stakeholders"]
      }
    ],
    "groups": [
      {
        "name": "Presenter Information",
        "description": "Personal and contact details of the presenter",
        "fields": ["presenter_first_name", "presenter_last_name", "presenter_title", "presenter_email", "presenter_phone"]
      },
      {
        "name": "Company Details",
        "description": "Information about your organization",
        "fields": ["company_name", "company_industry", "company_size", "company_website", "company_description"]
      },
      {
        "name": "Presentation Details",
        "description": "Information about the pitch content",
        "fields": ["pitch_focus", "target_audience"]
      }
    ]
  },

  "field_instructions": {},

  "constraints": {
    "focus_on": ["clear value proposition", "audience engagement", "professional delivery"],
    "keep_professional": true
  }
}

{
  "name": "event_template",
  "description": "Event planning template with structured form",
  "system_instructions": "Generate comprehensive event planning content that covers all logistical and organizational aspects of the event.",
  "tone": "professional and organized",

  "schema": {
    "fields": [
      {
        "name": "event_name",
        "type": "text",
        "required": true,
        "label": "Event Name",
        "description": "Name of the event",
        "max_length": 100
      },
      {
        "name": "event_type",
        "type": "enum",
        "required": true,
        "label": "Event Type",
        "description": "Type of event",
        "values": ["Conference", "Workshop", "Team Building", "Corporate Retreat", "Training"]
      },
      {
        "name": "location",
        "type": "text",
        "required": true,
        "label": "Location",
        "description": "Where the event will be held",
        "max_length": 200
      },
      {
        "name": "start_date",
        "type": "date",
        "required": true,
        "label": "Start Date",
        "description": "Event start date"
      },
      {
        "name": "end_date",
        "type": "date",
        "required": true,
        "label": "End Date",
        "description": "Event end date"
      },
      {
        "name": "total_budget",
        "type": "number",
        "required": true,
        "label": "Total Budget (USD)",
        "description": "Total budget for the event",
        "min": 5000,
        "max": 500000
      },
      {
        "name": "expected_attendees",
        "type": "number",
        "required": true,
        "label": "Expected Attendees",
        "description": "Number of participants",
        "min": 10,
        "max": 1000
      },
      {
        "name": "has_catering",
        "type": "boolean",
        "required": false,
        "label": "Include Catering",
        "description": "Will the event include meals?"
      },
      {
        "name": "dietary_requirements",
        "type": "textarea",
        "required": false,
        "label": "Dietary Requirements",
        "description": "Special dietary needs",
        "max_length": 300
      },
      {
        "name": "contact_email",
        "type": "email",
        "required": true,
        "label": "Contact Email",
        "description": "Email for event contact"
      }
    ],
    "groups": [
      {
        "name": "Event Details",
        "description": "Basic information about the event",
        "fields": ["event_name", "event_type", "location"]
      },
      {
        "name": "Schedule",
        "description": "Event date and duration",
        "fields": ["start_date", "end_date"]
      },
      {
        "name": "Attendance & Budget",
        "description": "Expected participants and financial details",
        "fields": ["expected_attendees", "total_budget"]
      },
      {
        "name": "Catering",
        "description": "Food and dietary requirements",
        "fields": ["has_catering", "dietary_requirements"]
      },
      {
        "name": "Contact Information",
        "description": "Primary contact details",
        "fields": ["contact_email"]
      }
    ]
  },

  "field_instructions": {},

  "constraints": {
    "focus_on": ["event logistics", "budget management", "attendee experience"],
    "keep_professional": true
  }
}

{
  "template_name": "template7",
  "description": "Event program schedule template with structured program planning",
  "fields": [
     {
      "name": "comapany_name",
      "type": "text",
      "required": true,
      "label": "Company Name",
      "description": "Name of your company",
      "max_length": 100
    },
    {
      "name": "event_name",
      "type": "text",
      "required": true,
      "label": "Event Name",
      "description": "Name of your event",
      "max_length": 100
    },
    {
      "name": "event_description",
      "type": "textarea",
      "required": false,
      "label": "Event Description",
      "description": "Brief description of the event",
      "max_length": 300
    },
    {
      "name": "event_start_date",
      "type": "date",
      "required": true,
      "label": "Event Start Date",
      "description": "First day of the event"
    },
    {
      "name": "event_end_date",
      "type": "date",
      "required": false,
      "label": "Event End Date",
      "description": "Last day of the event (leave empty for single-day events)"
    },
    {
      "name": "location",
      "type": "text",
      "required": false,
      "label": "Event Location",
      "description": "Where the event will be held",
      "max_length": 200
    },
    {
      "name": "program_schedule",
      "type": "program_table",
      "required": true,
      "label": "Program Schedule",
      "description": "Plan activities for each time slot of each day",
      "date_range_start_field": "event_start_date",
      "date_range_end_field": "event_end_date",
      "columns": ["Matinée", "Midi", "Après-midi", "Soir"],
      "cell_structure": {
        "parts": ["context", "team_building", "agency_offer"],
        "ai_generates": ["context"],
        "user_provides": ["context", "agency_offer"],
        "team_building_db": true
      }
    }
  ],
  "groups": [
    {
      "name": "Event Details",
      "description": "Basic event information and dates",
      "fields": ["event_name", "event_description", "event_start_date", "event_end_date", "location"]
    },
    {
      "name": "Program Schedule",
      "description": "Define activities for each time slot across event days",
      "fields": ["program_schedule"]
    }
  ]
}
